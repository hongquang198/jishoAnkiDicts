    "version": "0.2.0",
    "configurations": [
        {
            "name": "dev (local backend)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "dev",
                "--dart-define=FLAVOR=dev"
            ]
        },
        {
            "name": "prod (cloud backend)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "prod",
                "--dart-define=FLAVOR=prod"
            ]
        },
